<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Left"/></DataTemplate>
  <Style x:Key="KeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="9" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="MotionBody">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
      <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionPressed" Background="Black" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="MinHeight" Value="42"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid x:Name="MotionBody">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
      <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <ScrollViewer x:Name="PART_ContentHost"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Grid x:Name="MotionBody">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
      <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <ScrollViewer x:Name="PART_ContentHost"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="12,10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Grid x:Name="MotionBody">
      <Border Background="{DynamicResource Field}" CornerRadius="5"/>
      <Border x:Name="MotionCheck" Background="{DynamicResource Selected}" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="42"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid x:Name="MotionBody">
      <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="8"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="12,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="8" Padding="4" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="MotionBody" Background="Transparent" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="5"/>
        <Border x:Name="MotionCheck" Background="{DynamicResource Primary}" CornerRadius="5" Opacity="0"><Path Data="M 4 9 L 8 13 L 15 5" Stroke="White" StrokeThickness="1.8"/></Border>
        <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
        <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
      </Grid><ContentPresenter Grid.Column="1" RecognizesAccessKey="True"/>
    </Grid></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="MotionBody" Background="Transparent" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10"/>
        <Border x:Name="MotionCheck" Background="{DynamicResource Primary}" CornerRadius="10" Opacity="0"><Ellipse Fill="White" Width="8" Height="8"/></Border>
        <Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
        <Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
      </Grid><ContentPresenter Grid.Column="1" RecognizesAccessKey="True"/>
    </Grid></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
      <ToggleButton x:Name="HeaderButton" FocusVisualStyle="{StaticResource KeyboardFocus}" Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid x:Name="MotionBody"><Border Background="{DynamicResource Side}" CornerRadius="8"/><Border x:Name="MotionHover" Background="{DynamicResource Accent}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/><Border x:Name="MotionFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/><Border x:Name="MotionPressed" Background="Black" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/><ContentPresenter Margin="12,12"/></Grid></ControlTemplate></ToggleButton.Template>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Path x:Name="chevron" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}"/>
        </Grid>
      </ToggleButton>
      <ContentPresenter x:Name="details" Visibility="Collapsed" Margin="12,16,12,4"/>
    </StackPanel></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="4" Margin="4,0" Opacity="0.4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>