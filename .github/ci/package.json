{
  "name": "context-anywhere-ci-tools",
  "private": true,
  "type": "module",
  "description": "Unbundled official GitHub SDKs, installed from this lockfile and run with the verified project Node runtime.",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify": "node verify-runtime.mjs"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/attest": "3.2.0",
    "@actions/core": "3.0.1"
  },
  "overrides": {
    "undici@^6": "6.29.1",
    "@sigstore/sign": {
      "@sigstore/core": "3.2.1"
    }
  }
}
